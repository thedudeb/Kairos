# --- Required to run the backend at all -------------------------------------

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitment

# Redis (queue + cache)
REDIS_URL=redis://localhost:6379/0

# Shared with frontend Auth.js — must be the same value in both places
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Shared with frontend for the server-to-server user-sync call
INTERNAL_API_KEY=replace-with-openssl-rand-hex-32

# First admin bootstrap — when this email signs in via Google OAuth on the
# frontend, the user-sync endpoint creates them with role=admin
INITIAL_ADMIN_EMAIL=you@example.com

# Enables the passwordless demo administrator. Never enable in production.
DEMO_ENABLED=false

# CORS — the public origin of the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# The externally-reachable base URL of this backend service. Used for the
# token-signed resume-share links embedded in outbound webhook payloads
# (third-party receivers need to fetch the resume, so the link can't point
# at our admin-only proxy). For the supported local setup this is the address
# where the backend is reachable, normally localhost:8000.
PUBLIC_API_URL=http://localhost:8000

# Optional dedicated keys. If omitted, purpose-separated keys are derived from
# AUTH_SECRET. Dedicated values allow independent rotation.
RESUME_SHARE_SECRET=
ENCRYPTION_SECRET=

# Local directory for resumes and custom-field files. Mount this path on a
# persistent disk/volume in production.
LOCAL_UPLOAD_DIR=/tmp/recruitment-uploads

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=Recruiting <hello@example.com>

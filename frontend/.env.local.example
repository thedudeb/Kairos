# --- Auth.js core -------------------------------------------------------

# Generate with: openssl rand -base64 32
# MUST match backend AUTH_SECRET
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public URL of this app (no trailing slash)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth -------------------------------------------------------

# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Backend integration ------------------------------------------------

# URL of the FastAPI backend (used by the BFF for proxied API calls AND by
# the Auth.js signIn callback for the user-sync handshake)
BACKEND_URL=http://localhost:8000

# Server-to-server shared secret used only by the user-sync call.
# MUST match backend INTERNAL_API_KEY
INTERNAL_API_KEY=replace-with-openssl-rand-hex-32

# --- Demo mode ----------------------------------------------------------

# Server-only switch that both registers and displays the passwordless demo
# provider. Leave false in production. The backend DEMO_ENABLED must also match.
DEMO_ENABLED=false
